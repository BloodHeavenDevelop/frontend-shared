{
  "name": "@bloodheaven/frontend-shared",
  "version": "0.3.0",
  "description": "Shared Nuxt-layer BloodHeaven: canonical UI-primitives design-system (.hm-*)",
  "type": "module",
  "private": false,
  "files": [
    "assets",
    "components",
    "pages",
    "public",
    "nuxt.config.ts"
  ],
  "exports": {
    ".": {
      "import": "./nuxt.config.ts"
    },
    "./assets/*": "./assets/*",
    "./components/*": "./components/*",
    "./pages/*": "./pages/*"
  },
  "peerDependencies": {
    "@vuepic/vue-datepicker": "^11.0.2",
    "date-fns": "^4.1.0",
    "nuxt": "^4.1.1",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@vuepic/vue-datepicker": "^11.0.3",
    "date-fns": "^4.4.0",
    "yup": "^1.7.1"
  }
}
